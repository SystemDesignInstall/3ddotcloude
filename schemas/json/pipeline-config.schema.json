{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatial-platform.dev/schemas/json/pipeline-config.schema.json",
  "title": "Pipeline Run Configuration",
  "description": "Configuration for a pipeline run (reconstruction-pipeline.md). Recipes (deferred) refine this into canonical named versions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline_id", "output_targets"],
  "properties": {
    "pipeline_id": {
      "type": "string",
      "enum": ["photogrammetry", "video", "lidar_slam", "hybrid", "mesh", "gaussian", "quality"]
    },
    "recipe_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipe_id": { "type": "string" },
        "version": { "type": "string" }
      },
      "description": "Optional reference to a named recipe (recipe.schema.json)."
    },
    "parameters": {
      "type": "object",
      "description": "Pipeline parameters; included in configuration_hash."
    },
    "output_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["sparse_cloud", "dense_cloud", "mesh", "textured_mesh", "gaussian", "trajectory", "quality_report"]
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cpu_cores": { "type": "integer", "minimum": 1 },
        "max_ram_mb": { "type": "integer", "minimum": 1 },
        "max_gpu_vram_mb": { "type": "integer", "minimum": 1 },
        "max_temp_gb": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "examples": [
    {
      "pipeline_id": "photogrammetry",
      "recipe_ref": { "recipe_id": "rc_high_accuracy", "version": "1.2.0" },
      "parameters": { "matcher": "auto", "dense_scale": 1.0 },
      "output_targets": ["textured_mesh", "gaussian", "quality_report"],
      "resource_limits": { "max_cpu_cores": 16, "max_ram_mb": 65536, "max_gpu_vram_mb": 24576, "max_temp_gb": 200 }
    }
  ]
}
