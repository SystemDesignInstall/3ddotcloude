+class Ac22DeterminismTest : public RealGtsamBundleAdjustmentTest {
+ protected:
+  // Runs the ENTIRE production chain in a FRESH project wired with all four
+  // REAL seams, using the pinned AC-22 identity constants and the caller's
+  // fixed committed geometry/pixels. The engine is returned by value (its DB
+  // handle stays open, so the caller must destroy it before TearDown removes
+  // root_); basic run results land in `ev`, the geometry evidence is collected
+  // by CollectEvidence (called from the test body where ASSERT is legal).
+  std::unique_ptr<Engine> RunAc22Twin(const std::string& dir_name,
+                                      const std::string& project_uuid,
+                                      const CommittedGeometry& committed,
+                                      const RenderedScene& rendered,
+                                      Ac22TwinEvidence* ev) {
+    ProjectInfo info;
+    info.uuid = ParseUuid(project_uuid);
+    info.name = "ac22-" + dir_name;
+    info.created_at = Iso8601UtcNow();
+    auto project = std::make_unique<Project>(
+        Project::Create(root_ / (dir_name + ".spx"), info));
+
+    const std::string src_frame = kAc22SrcFrame;
+    const std::string tgt_frame = kAc22TgtFrame;
+    const std::string traj = kAc22TrajectoryId;
+
+    // The committed reconstruction: identical bytes in both projects (fixed
+    // identity + fixed geometry), so the input recon_hash is bit-identical.
+    Reconstruction recon;
+    recon.reconstruction_id = kAc22ReconId;
+    recon.scene_id = "22222222-2222-4222-8222-222222222222";
+    recon.session_ids = {"33333333-3333-4333-8333-333333333333"};
+    recon.coordinate_frame = "trajectory_0";
+    recon.status = "succeeded";
+    recon.created_at_ns = 100;
+    recon.provenance.backend.name = "colmap";
+    recon.provenance.backend.version = "v2";
+    recon.provenance.backend.adapter_version = "test";
+    recon.provenance.configuration_hash =
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    recon.cameras.push_back(PinholeCamera(1));
+    recon.cameras.push_back(PinholeCamera(2));
+    const Eigen::Vector3d drifted_t = DriftedTargetTranslation();
+    const std::array<double, 4> drifted_r = QuatXyzw(DriftedTargetRotation());
+    ReconImage src_img;
+    src_img.image_id = 1;
+    src_img.camera_id = 1;
+    src_img.frame_id = src_frame;
+    src_img.name = "frame_s.jpg";
+    src_img.pose.rotation_xyzw = {0.0, 0.0, 0.0, 1.0};
+    src_img.pose.translation_xyz = {0.0, 0.0, 0.0};
+    src_img.detected = true;
+    ReconImage tgt_img;
+    tgt_img.image_id = 2;
+    tgt_img.camera_id = 2;
+    tgt_img.frame_id = tgt_frame;
+    tgt_img.name = "frame_t.jpg";
+    tgt_img.pose.rotation_xyzw = drifted_r;
+    tgt_img.pose.translation_xyz = {drifted_t.x(), drifted_t.y(),
+                                    drifted_t.z()};
+    tgt_img.detected = true;
+    recon.images.push_back(src_img);
+    recon.images.push_back(tgt_img);
+    recon.points3D = committed.points;
+    const std::string doc = ReconstructionToJson(recon);
+    const std::vector<std::uint8_t> doc_bytes(doc.begin(), doc.end());
+    ArtifactManifest doc_manifest;
+    doc_manifest.artifact_uuid = GenerateUuid();
+    doc_manifest.type = "reconstruction";
+    doc_manifest.schema_version = 2;
+    doc_manifest.producer = {"spatial-platform", "0.1.0", "test"};
+    doc_manifest.creation_timestamp = Iso8601UtcNow();
+    const std::string recon_hash =
+        project->artifacts().Put(doc_bytes, doc_manifest).content_hash;
+
+    auto& db = project->db();
+    auto& store = project->artifacts();
+    auto put_features = [&](const Uuid& frame_id,
+                            const std::vector<std::pair<double, double>>& pts,
+                            std::string* content_hash) {
+      WriteFeatureArtifactInput input;
+      input.frame_id = frame_id;
+      input.detector = "mock";
+      input.descriptor_type = "mock_16";
+      input.input_content_hash = "image-" + FormatUuid(frame_id);
+      for (std::size_t i = 0; i < pts.size(); ++i) {
+        input.keypoints.push_back(
+            {pts[i].first, pts[i].second, 1.0, 0.0, 0.5});
+        std::uint32_t h = static_cast<std::uint32_t>(i + 1) * 2654435761u;
+        std::vector<double> row(16);
+        for (auto& v : row) {
+          h = h * 1664525u + 1013904223u;
+          v = static_cast<double>(h >> 8) * (1.0 / 16777216.0);
+        }
+        input.descriptors.push_back(std::move(row));
+      }
+      const FeatureExtractionResult result =
+          WriteFeatureArtifact(store, db, input);
+      if (content_hash != nullptr) *content_hash = result.content_hash;
+      return FormatUuid(result.artifact_uuid);
+    };
+    // Fixed frame ids + fixed pixels/descriptors -> bit-identical feature
+    // payloads across the twins (SHA-256 of the payload is the CAS content
+    // hash, so the feature content hashes agree as well).
+    const std::string src_art =
+        put_features(ParseUuid(src_frame), rendered.pair.src, &ev->src_art_hash);
+    const std::string tgt_art =
+        put_features(ParseUuid(tgt_frame), rendered.pair.tgt, &ev->tgt_art_hash);
+
+    // Drifted trajectory context mirroring RunDrifted, with FIXED identities.
+    const Eigen::Vector3d drifted = DriftedTargetTranslation();
+    const std::array<double, 4> drifted_node_r =
+        QuatXyzw(DriftedTargetRotation());
+    const json nodes = json::array(
+        {{{"frame_id", src_frame},
+          {"timestamp_ns", 2000},
+          {"sequence_index", 0},
+          {"position_xyz", {0.0, 0.0, 0.0}},
+          {"rotation_xyzw", {0.0, 0.0, 0.0, 1.0}}},
+         {{"frame_id", tgt_frame},
+          {"timestamp_ns", 1000},
+          {"sequence_index", 7},
+          {"position_xyz", {drifted.x(), drifted.y(), drifted.z()}},
+          {"rotation_xyzw",
+           {drifted_node_r[0], drifted_node_r[1], drifted_node_r[2],
+            drifted_node_r[3]}}}});
+    const json basis = {{"declared", true},
+                        {"type", "odometry_scale"},
+                        {"source", "trajectory"},
+                        {"scale_calibration_ref", "calib-ref-1"},
+                        {"provenance",
+                         {{"configuration_hash",
+                           "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+                           "bbbbbbbb"}}}};
+    const json lc = {
+        {"metric",
+         {{"trajectory",
+           {{"trajectory_id", traj},
+            {"scene_id", "scene-1"},
+            {"session_id", "session-1"},
+            {"kind", "sfm"},
+            {"coordinate_frame", "trajectory_0"},
+            {"status", "building"},
+            {"created_at_ns", 0},
+            {"metric_basis", basis},
+            {"nodes", nodes}}}}},
+        {"loop_closure",
+         {{"candidate",
+           {{"candidate_id", kAc22CandidateId},
+            {"trajectory_id", traj},
+            {"source_frame_id", src_frame},
+            {"target_frame_id", tgt_frame},
+            {"feature_match_score", 999.0},
+            {"matcher", "visual_l2_nearest"},
+            {"created_at_ns", 0}}},
+          {"source_frame",
+           {{"frame_id", src_frame},
+            {"timestamp_ns", 2000},
+            {"feature_artifact_uuid", src_art}}},
+          {"target_frame",
+           {{"frame_id", tgt_frame},
+            {"timestamp_ns", 1000},
+            {"feature_artifact_uuid", tgt_art}}}}}};
+    json cfg = {{"project_id", project_uuid},
+                {"scene_name", kAc22SceneName},
+                {"random_seed", kAc22Seed}};
+    cfg.update(lc);
+
+    SparseCorrectionSeams seams;
+    seams.ba_optimizer = &real_ba_;
+    seams.matcher = &matcher_;
+    seams.verifier = &essential_;
+    seams.trajectory_optimizer = &gtsam_;
+    auto engine = std::make_unique<Engine>(
+        std::move(*project),
+        MakeSparseCorrectionRunner(db, store, seams, {}),
+        SparseCorrectionProfile());
+    project.reset();
+    RegisterProductionPipelines(engine->registry());
+
+    ev->manifest = engine->RunPipeline(kSparseCorrectionPipelineId,
+                                       {recon_hash}, cfg.dump());
+    ev->cfg = std::move(cfg);
+    ev->recon_hash = recon_hash;
+    return engine;
+  }
+
+  // Classifies the persisted revisions and resolves the canonical evidence of
+  // one twin. ASSERT is legal here (void return).
+  void CollectEvidence(Engine& engine, const Uuid& project_id,
+                       Ac22TwinEvidence* ev) {
+    auto& db = engine.project().db();
+    auto& store = engine.project().artifacts();
+    const auto scene = db.FindSceneByProject(project_id);
+    ASSERT_TRUE(scene.has_value());
+    ev->rows = db.FindReconstructionsByScene(scene->scene_id);
+
+    const auto lc_rows = db.FindArtifactsByType("loop_closure");
+    ASSERT_EQ(lc_rows.size(), 1u);
+    const auto lc_bytes = store.Get(lc_rows.front().content_hash);
+    ASSERT_TRUE(lc_bytes.has_value());
+    const json lc_payload =
+        json::parse(std::string(lc_bytes->begin(), lc_bytes->end()));
+    ASSERT_EQ(lc_payload["closures"].size(), 1u);
+    ev->closure = lc_payload["closures"][0];
+
+    const auto graphs =
+        db.FindPoseGraphsByTrajectory(ParseUuid(kAc22TrajectoryId));
+    ASSERT_EQ(graphs.size(), 1u);
+    ev->graph_doc = json::parse(graphs[0].document_json);
+
+    const auto opt_artifacts = db.FindArtifactsByType("optimization_result");
+    ASSERT_EQ(opt_artifacts.size(), 1u);
+    const auto opt_bytes = store.Get(opt_artifacts.front().content_hash);
+    ASSERT_TRUE(opt_bytes.has_value());
+    ev->opt_payload =
+        json::parse(std::string(opt_bytes->begin(), opt_bytes->end()));
+
+    ev->applied = FindDocByBackend(ev->rows, "spatial_optimizer");
+    ev->v3 = FindDocByBackend(ev->rows, "spatial_retriangulator");
+    ev->v4 = FindDocByBackend(ev->rows, "spatial_gtsam_bundle_adjuster");
+    ASSERT_FALSE(ev->applied.is_null());
+    ASSERT_FALSE(ev->v3.is_null());
+    ASSERT_FALSE(ev->v4.is_null());
+  }
+
+  static json FindDocByBackend(
+      const std::vector<spatial::core::ReconstructionRow>& rows,
+      const std::string& backend_name) {
+    for (const auto& row : rows) {
+      const json doc = json::parse(row.document_json);
+      if (doc.at("provenance").at("backend").at("name").get<std::string>() ==
+          backend_name)
+        return doc;
+    }
+    EXPECT_TRUE(false) << "no revision with backend '" << backend_name << "'";
+    return json();
+  }
+
+  // Exact comparison of the semantic loop-closure measurement: every persisted
+  // closure field except the runtime instance identity (closure_id, the
+  // wall-clock created_at_ns), which are compared by contract.
+  void ExpectClosureCoreEqual(const Ac22TwinEvidence& a,
+                              const Ac22TwinEvidence& b) const {
+    EXPECT_EQ(a.closure["trajectory_id"], b.closure["trajectory_id"]);
+    EXPECT_EQ(a.closure["trajectory_id"].get<std::string>(),
+              std::string(kAc22TrajectoryId));
+    EXPECT_EQ(a.closure["candidate_id"], b.closure["candidate_id"]);
+    EXPECT_EQ(a.closure["candidate_id"].get<std::string>(),
+              std::string(kAc22CandidateId));
+    EXPECT_EQ(a.closure["source_frame_id"], b.closure["source_frame_id"]);
+    EXPECT_EQ(a.closure["source_frame_id"].get<std::string>(),
+              std::string(kAc22SrcFrame));
+    EXPECT_EQ(a.closure["target_frame_id"], b.closure["target_frame_id"]);
+    EXPECT_EQ(a.closure["target_frame_id"].get<std::string>(),
+              std::string(kAc22TgtFrame));
+    EXPECT_EQ(a.closure["status"].get<std::string>(), "accepted");
+    EXPECT_EQ(b.closure["status"].get<std::string>(), "accepted");
+    EXPECT_TRUE(a.closure["has_relative_pose"].get<bool>());
+    EXPECT_TRUE(b.closure["has_relative_pose"].get<bool>());
+    EXPECT_GT(a.closure["inlier_count"].get<std::int64_t>(), 0);
+    EXPECT_EQ(a.closure["inlier_count"].get<std::int64_t>(),
+              b.closure["inlier_count"].get<std::int64_t>());
+    EXPECT_EQ(a.closure["temporal_separation_ns"].get<std::int64_t>(),
+              b.closure["temporal_separation_ns"].get<std::int64_t>());
+    // bit-deterministic measurement path: fixed-seed RANSAC + pure D6 resolver
+    EXPECT_DOUBLE_EQ(a.closure["inlier_ratio"].get<double>(),
+                     b.closure["inlier_ratio"].get<double>());
+    EXPECT_DOUBLE_EQ(a.closure["confidence"].get<double>(),
+                     b.closure["confidence"].get<double>());
+    EXPECT_DOUBLE_EQ(a.closure["spatial_separation_m"].get<double>(),
+                     b.closure["spatial_separation_m"].get<double>());
+    for (int i = 0; i < 3; ++i)
+      EXPECT_DOUBLE_EQ(a.closure["relative_position_xyz"][i].get<double>(),
+                       b.closure["relative_position_xyz"][i].get<double>());
+    for (int i = 0; i < 4; ++i)
+      EXPECT_DOUBLE_EQ(a.closure["relative_rotation_xyzw"][i].get<double>(),
+                       b.closure["relative_rotation_xyzw"][i].get<double>());
+    EXPECT_DOUBLE_EQ(a.closure["geometric_residual"].get<double>(),
+                     b.closure["geometric_residual"].get<double>());
+    // runtime identity by contract: a fresh closure id per execution
+    EXPECT_NE(a.closure["closure_id"], b.closure["closure_id"]);
+    EXPECT_NE(a.closure["created_at_ns"], b.closure["created_at_ns"]);
+  }
