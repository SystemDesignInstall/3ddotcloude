+  // Pose-graph: nodes + the verbatim metric edge, compared on every semantic
+  // field (graph_id is runtime-only; the edge configuration_hash carries the
+  // project-specific pipeline hash).
+  void ExpectPoseGraphCoreEqual(const Ac22TwinEvidence& a,
+                                const Ac22TwinEvidence& b) const {
+    EXPECT_EQ(a.graph_doc["trajectory_id"], b.graph_doc["trajectory_id"]);
+    EXPECT_EQ(a.graph_doc["trajectory_id"].get<std::string>(),
+              std::string(kAc22TrajectoryId));
+    EXPECT_NE(a.graph_doc["graph_id"], b.graph_doc["graph_id"]);
+    ASSERT_EQ(a.graph_doc["nodes"].size(), 2u);
+    ASSERT_EQ(b.graph_doc["nodes"].size(), 2u);
+    for (int i = 0; i < 2; ++i) {
+      EXPECT_EQ(a.graph_doc["nodes"][i]["node_id"],
+                b.graph_doc["nodes"][i]["node_id"]);
+      EXPECT_EQ(a.graph_doc["nodes"][i]["frame_id"],
+                b.graph_doc["nodes"][i]["frame_id"]);
+      EXPECT_EQ(a.graph_doc["nodes"][i]["timestamp_ns"],
+                b.graph_doc["nodes"][i]["timestamp_ns"]);
+    }
+    ASSERT_EQ(a.graph_doc["edges"].size(), 1u);
+    ASSERT_EQ(b.graph_doc["edges"].size(), 1u);
+    const json& ea = a.graph_doc["edges"][0];
+    const json& eb = b.graph_doc["edges"][0];
+    EXPECT_EQ(ea["type"], eb["type"]);
+    EXPECT_EQ(ea["type"].get<std::string>(), "loop_closure");
+    EXPECT_EQ(ea["source"], eb["source"]);
+    EXPECT_EQ(ea["source_node_id"], eb["source_node_id"]);
+    EXPECT_EQ(ea["source_node_id"].get<std::int64_t>(), 0);
+    EXPECT_EQ(ea["target_node_id"], eb["target_node_id"]);
+    EXPECT_EQ(ea["target_node_id"].get<std::int64_t>(), 1);
+    for (int i = 0; i < 3; ++i)
+      EXPECT_DOUBLE_EQ(ea["relative_position_xyz"][i].get<double>(),
+                       eb["relative_position_xyz"][i].get<double>());
+    for (int i = 0; i < 4; ++i)
+      EXPECT_DOUBLE_EQ(ea["relative_rotation_xyzw"][i].get<double>(),
+                       eb["relative_rotation_xyzw"][i].get<double>());
+    ASSERT_EQ(ea["information_matrix_6x6"].size(), 36u);
+    ASSERT_EQ(eb["information_matrix_6x6"].size(), 36u);
+    for (int i = 0; i < 36; ++i)
+      EXPECT_DOUBLE_EQ(ea["information_matrix_6x6"][i].get<double>(),
+                       eb["information_matrix_6x6"][i].get<double>());
+    EXPECT_DOUBLE_EQ(ea["confidence"].get<double>(),
+                     eb["confidence"].get<double>());
+  }
