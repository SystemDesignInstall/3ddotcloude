+// ===========================================================================
+// AC-22 тАФ DETERMINISTIC SECOND RUN THROUGH THE PRODUCTION SURFACE.
+// ===========================================================================
+//
+// Two INDEPENDENT runs of the FULL corrected chain тАФ each driven by ONE
+// Engine::RunPipeline("p3_sparse_correction", ...) against a FRESH project
+// with ALL FOUR seams real (L2NearestMatcher + EssentialGeometricVerifier +
+// GtsamTrajectoryOptimizer + GtsamBundleAdjustmentOptimizer) тАФ over
+// BIT-IDENTICAL pinned inputs: fixed identity constants (reconstruction,
+// frames, candidate, trajectory), one rendered scene, one committed geometry,
+// one pinned non-empty random_seed. Nothing below calls a host-stage function
+// directly; the engine surface is the only entry point.
+//
+// Why two projects? The DB-committing correction stage is CachePolicy::kNever
+// and MetadataDb::AddReconstruction is a plain PK INSERT: a second identical
+// invocation in the SAME project refuses the duplicate committed identity and
+// fails closed (N5) instead of executing the chain again. That replay IS the
+// N5 contract (asserted below), but it is not a computation probe. The twin
+// projects provide the probe: two genuine serial executions that must agree
+// semantically.
+//
+// Numerical tolerance: asserted EXACTLY (EXPECT_DOUBLE_EQ) where the contract
+// is bit-deterministic тАФ the measurement path (fixed-seed RANSAC over fixed
+// pixels, plus the pure D6 unit->metric resolution against fixed trajectory
+// nodes; the pose-graph edge is a VERBATIM copy of that measurement) тАФ and
+// with small ABSOLUTE tolerances where identical in-process GTSAM LM solves
+// (single-threaded, COLAMD-ordered factor graph, no random numbers; the pinned
+// seed is validated/recorded but consumed by none of the seams) and the frozen
+// DLT/D5/apply re-derivations are expected to reproduce:
+//   kAc22PoseTol      = 1e-9  тАФ optimized/optimizer-fed pose arrays and BA
+//                               rms/mean px telemetry (9 orders below any
+//                               measurement significance);
+//   kAc22GeometryTol  = 1e-6  тАФ re-triangulated / BA-refined 3D world points
+//                               (metres; the DLT and LM maps here are
+//                               well-conditioned so accumulated FPU noise is
+//                               orders of magnitude smaller).
+// A future port to a different FPU that reorders the LM summations is the
+// documented reason to widen a kAc22*Tol bound тАФ NOT a reason to weaken a
+// semantic comparison below it.
+//
+// Runtime-only identity (fresh UUIDs тАФ closure_id, graph_id, result_id,
+// revision/artifact ids; the wall-clock closure created_at; the per-project DB
+// scene id; the project_id inside the config) is compared BY CONTRACT: the two
+// configs provably differ in exactly the project_id, which changes only the
+// config/pipeline hash and never a semantic value.
+//
+// The block also re-proves the N5 duplicate refusal with the REAL seams (the
+// N5 suite used the StubOptimizer): a third identical invocation in run A's
+// project must fail closed at the duplicate committed identity, leave the
+// revision lineage byte-identical, and never produce a divergent reconstruction.
+constexpr const char* kAc22ProjectA = "10000000-0000-4000-8000-000000000001";
+constexpr const char* kAc22ProjectB = "10000000-0000-4000-8000-000000000002";
+constexpr const char* kAc22ReconId = "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee";
+constexpr const char* kAc22SrcFrame = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+constexpr const char* kAc22TgtFrame = "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb";
+constexpr const char* kAc22CandidateId = "cccccccc-cccc-4ccc-8ccc-cccccccccccc";
+constexpr const char* kAc22TrajectoryId = "dddddddd-dddd-4ddd-8ddd-dddddddddddd";
+constexpr const char* kAc22Seed = "pinned-ac22";
+constexpr const char* kAc22SceneName = "ac22_scene";
+constexpr double kAc22PoseTol = 1e-9;
+constexpr double kAc22GeometryTol = 1e-6;
+constexpr double kAc22TelemetryTol = 1e-9;
+
+struct Ac22TwinEvidence {
+  spatial::engine::ExecutionManifest manifest;
+  json cfg;  // parsed config exactly as submitted to RunPipeline
+  std::string recon_hash;
+  std::string src_art_hash;
+  std::string tgt_art_hash;
+  json closure;      // loop-closure CAS payload closures[0]
+  json graph_doc;    // pose-graph CAS document
+  json opt_payload;  // optimization-result CAS document
+  json applied;
+  json v3;
+  json v4;
+  std::vector<spatial::core::ReconstructionRow> rows;
+};
