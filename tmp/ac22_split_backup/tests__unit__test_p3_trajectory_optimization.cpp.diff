+  // Optimization result: converged, deterministic GTSAM LM numerics; the fresh
+  // result_id/graph_id are runtime-only and the graph linkage is re-checked.
+  void ExpectOptimizationCoreEqual(const Ac22TwinEvidence& a,
+                                   const Ac22TwinEvidence& b) const {
+    EXPECT_EQ(a.opt_payload["status"].get<std::string>(), "converged");
+    EXPECT_EQ(b.opt_payload["status"].get<std::string>(), "converged");
+    EXPECT_EQ(a.opt_payload["trajectory_id"].get<std::string>(),
+              std::string(kAc22TrajectoryId));
+    EXPECT_EQ(b.opt_payload["trajectory_id"].get<std::string>(),
+              std::string(kAc22TrajectoryId));
+    EXPECT_NE(a.opt_payload["result_id"], b.opt_payload["result_id"]);
+    EXPECT_NE(a.opt_payload["graph_id"], b.opt_payload["graph_id"]);
+    EXPECT_EQ(a.opt_payload["graph_id"], a.graph_doc["graph_id"]);
+    EXPECT_EQ(b.opt_payload["graph_id"], b.graph_doc["graph_id"]);
+    EXPECT_GT(a.opt_payload["iterations"].get<std::int64_t>(), 0);
+    EXPECT_EQ(a.opt_payload["iterations"].get<std::int64_t>(),
+              b.opt_payload["iterations"].get<std::int64_t>());
+    EXPECT_NEAR(a.opt_payload["initial_error"].get<double>(),
+                b.opt_payload["initial_error"].get<double>(), kAc22PoseTol);
+    EXPECT_GT(a.opt_payload["initial_error"].get<double>(), 0.0);
+    EXPECT_LT(a.opt_payload["final_error"].get<double>(),
+              a.opt_payload["initial_error"].get<double>());
+    EXPECT_NEAR(a.opt_payload["final_error"].get<double>(),
+                b.opt_payload["final_error"].get<double>(), kAc22PoseTol);
+    EXPECT_NEAR(a.opt_payload["error_reduction"].get<double>(),
+                b.opt_payload["error_reduction"].get<double>(), kAc22PoseTol);
+    ASSERT_EQ(a.opt_payload["nodes"].size(), 2u);
+    ASSERT_EQ(b.opt_payload["nodes"].size(), 2u);
+    for (int i = 0; i < 2; ++i) {
+      const json& na = a.opt_payload["nodes"][i];
+      const json& nb = b.opt_payload["nodes"][i];
+      EXPECT_EQ(na["frame_id"], nb["frame_id"]);
+      EXPECT_EQ(na["timestamp_ns"], nb["timestamp_ns"]);
+      EXPECT_EQ(na["sequence_index"], nb["sequence_index"]);
+      for (int k = 0; k < 3; ++k)
+        EXPECT_NEAR(na["position_xyz"][k].get<double>(),
+                    nb["position_xyz"][k].get<double>(), kAc22PoseTol);
+      for (int k = 0; k < 4; ++k)
+        EXPECT_NEAR(na["rotation_xyzw"][k].get<double>(),
+                    nb["rotation_xyzw"][k].get<double>(), kAc22PoseTol);
+      ASSERT_EQ(na["covariance_position"].size(),
+                nb["covariance_position"].size());
+      for (std::size_t k = 0; k < na["covariance_position"].size(); ++k)
+        EXPECT_NEAR(na["covariance_position"][k].get<double>(),
+                    nb["covariance_position"][k].get<double>(), kAc22PoseTol);
+      ASSERT_EQ(na["covariance_rotation"].size(),
+                nb["covariance_rotation"].size());
+      for (std::size_t k = 0; k < na["covariance_rotation"].size(); ++k)
+        EXPECT_NEAR(na["covariance_rotation"][k].get<double>(),
+                    nb["covariance_rotation"][k].get<double>(), kAc22PoseTol);
+    }
+  }
+
+  // Semantic equality of two reconstruction revision documents for the AC-22
+  // comparison: structure/identity-field exact, numeric geometry within the
+  // documented tolerances (identity is runtime-only and asserted different).
+  void ExpectRevisionNumericEqual(const json& x, const json& y) const {
+    EXPECT_EQ(x["status"], y["status"]);
+    EXPECT_EQ(x["scene_id"], y["scene_id"]);
+    EXPECT_EQ(x["coordinate_frame"], y["coordinate_frame"]);
+    EXPECT_EQ(x["cameras"], y["cameras"]);  // D3: intrinsics pass through verbatim
+    ASSERT_EQ(x["images"].size(), y["images"].size());
+    for (std::size_t i = 0; i < x["images"].size(); ++i) {
+      const json& ix = x["images"][i];
+      const json& iy = y["images"][i];
+      EXPECT_EQ(ix["image_id"], iy["image_id"]);
+      EXPECT_EQ(ix["camera_id"], iy["camera_id"]);
+      EXPECT_EQ(ix["frame_id"], iy["frame_id"]);
+      EXPECT_EQ(ix["name"], iy["name"]);
+      EXPECT_EQ(ix["detected"], iy["detected"]);
+      for (int k = 0; k < 3; ++k)
+        EXPECT_NEAR(ix["pose"]["translation_xyz"][k].get<double>(),
+                    iy["pose"]["translation_xyz"][k].get<double>(),
+                    kAc22PoseTol);
+      for (int k = 0; k < 4; ++k)
+        EXPECT_NEAR(ix["pose"]["rotation_xyzw"][k].get<double>(),
+                    iy["pose"]["rotation_xyzw"][k].get<double>(), kAc22PoseTol);
+    }
+    ASSERT_EQ(x["points3D"].size(), y["points3D"].size());
+    for (std::size_t i = 0; i < x["points3D"].size(); ++i) {
+      const json& px = x["points3D"][i];
+      const json& py = y["points3D"][i];
+      EXPECT_EQ(px["point3d_id"], py["point3d_id"]);
+      EXPECT_EQ(px["track"], py["track"]);
+      for (int k = 0; k < 3; ++k)
+        EXPECT_NEAR(px["xyz"][k].get<double>(), py["xyz"][k].get<double>(),
+                    kAc22GeometryTol);
+      if (px.contains("error") && py.contains("error"))
+        EXPECT_NEAR(px["error"].get<double>(), py["error"].get<double>(),
+                    kAc22GeometryTol);
+    }
+  }
+
+  // Applied / v3 / v4 semantic comparison plus the deterministic clock chain.
+  void ExpectCorrectionRevisionsEqual(const Ac22TwinEvidence& a,
+                                      const Ac22TwinEvidence& b) const {
+    // applied (pose-corrected revision)
+    EXPECT_EQ(a.applied["provenance"]["backend"]["name"].get<std::string>(),
+              "spatial_optimizer");
+    EXPECT_EQ(b.applied["provenance"]["backend"]["name"].get<std::string>(),
+              "spatial_optimizer");
+    // created_at_ns is the wall-clock revision stamp: runtime-only by contract
+    EXPECT_NE(a.applied["created_at_ns"].get<std::int64_t>(),
+              b.applied["created_at_ns"].get<std::int64_t>());
+    EXPECT_NE(a.applied["reconstruction_id"], b.applied["reconstruction_id"]);
+    ExpectRevisionNumericEqual(a.applied, b.applied);
+    // v3 (retriangulated geometry)
+    EXPECT_EQ(a.v3["provenance"]["backend"]["name"].get<std::string>(),
+              "spatial_retriangulator");
+    EXPECT_EQ(b.v3["provenance"]["backend"]["name"].get<std::string>(),
+              "spatial_retriangulator");
+    EXPECT_NE(a.v3["created_at_ns"].get<std::int64_t>(),
+              b.v3["created_at_ns"].get<std::int64_t>());
+    EXPECT_EQ(a.v3["provenance"]["backend_specific_json"].get<std::string>(),
+              b.v3["provenance"]["backend_specific_json"].get<std::string>());
+    EXPECT_NE(a.v3["reconstruction_id"], b.v3["reconstruction_id"]);
+    ExpectRevisionNumericEqual(a.v3, b.v3);
+    // v4 (real-GTSAM-refined terminal revision)
+    EXPECT_EQ(a.v4["provenance"]["backend"]["name"].get<std::string>(),
+              "spatial_gtsam_bundle_adjuster");
+    EXPECT_EQ(b.v4["provenance"]["backend"]["name"].get<std::string>(),
+              "spatial_gtsam_bundle_adjuster");
+    EXPECT_NE(a.v4["created_at_ns"].get<std::int64_t>(),
+              b.v4["created_at_ns"].get<std::int64_t>());
+    EXPECT_EQ(a.v4["created_at_ns"].get<std::int64_t>(),
+              a.v3["created_at_ns"].get<std::int64_t>() + 100);
+    // the adapter configuration hash is a pure function of (source data,
+    // options, pinned seed) тАФ deliberately NOT the project-specific pipeline
+    // hash тАФ so it agrees across the twins and pins the D6 seed.
+    EXPECT_EQ(a.v4["provenance"]["configuration_hash"],
+              b.v4["provenance"]["configuration_hash"]);
+    EXPECT_NE(a.v4["reconstruction_id"], b.v4["reconstruction_id"]);
+    ExpectRevisionNumericEqual(a.v4, b.v4);
+    const json ta = json::parse(
+        a.v4["provenance"]["backend_specific_json"].get<std::string>());
+    const json tb = json::parse(
+        b.v4["provenance"]["backend_specific_json"].get<std::string>());
+    EXPECT_EQ(ta["optimizer"].get<std::string>(), "LevenbergMarquardt");
+    EXPECT_EQ(tb["optimizer"].get<std::string>(), "LevenbergMarquardt");
+    EXPECT_EQ(ta["seed"].get<std::string>(), std::string(kAc22Seed));
+    EXPECT_EQ(tb["seed"].get<std::string>(), std::string(kAc22Seed));
+    EXPECT_EQ(ta["iterations"].get<std::int64_t>(),
+              tb["iterations"].get<std::int64_t>());
+    EXPECT_EQ(ta["converged"].get<bool>(), tb["converged"].get<bool>());
+    EXPECT_NEAR(ta["rms_before"].get<double>(), tb["rms_before"].get<double>(),
+                kAc22TelemetryTol);
+    EXPECT_NEAR(ta["rms_after"].get<double>(), tb["rms_after"].get<double>(),
+                kAc22TelemetryTol);
+    EXPECT_NEAR(ta["mean_before"].get<double>(), tb["mean_before"].get<double>(),
+                kAc22TelemetryTol);
+    EXPECT_NEAR(ta["mean_after"].get<double>(), tb["mean_after"].get<double>(),
+                kAc22TelemetryTol);
+    EXPECT_EQ(ta["inlier_count_before"].get<std::int64_t>(),
+              tb["inlier_count_before"].get<std::int64_t>());
+    EXPECT_EQ(ta["inlier_count_after"].get<std::int64_t>(),
+              tb["inlier_count_after"].get<std::int64_t>());
+    EXPECT_EQ(ta["outlier_count_before"].get<std::int64_t>(),
+              tb["outlier_count_before"].get<std::int64_t>());
+    EXPECT_EQ(ta["outlier_count_after"].get<std::int64_t>(),
+              tb["outlier_count_after"].get<std::int64_t>());
+    EXPECT_LT(ta["rms_after"].get<double>(), ta["rms_before"].get<double>());
+  }
+};
+
+TEST_F(Ac22DeterminismTest,
+       AC22_DeterministicSecondRunThroughProductionSurface) {
+  const RenderedScene scene = RenderScene(36, 7u, /*noise_px=*/0.4);
+  const CommittedGeometry committed = CommittedPointsUnderDrift(scene);
+  ASSERT_GT(committed.points.size(), 10u);  // fixture sanity
+
+  Ac22TwinEvidence ev_a;
+  Ac22TwinEvidence ev_b;
+  auto engine_a =
+      RunAc22Twin("ac22_a", kAc22ProjectA, committed, scene, &ev_a);
+  auto engine_b =
+      RunAc22Twin("ac22_b", kAc22ProjectB, committed, scene, &ev_b);
+  auto& store_a = engine_a->project().artifacts();
+  auto& store_b = engine_b->project().artifacts();
+  ASSERT_EQ(ev_a.manifest.status, "succeeded");
+  ASSERT_EQ(ev_b.manifest.status, "succeeded");
+  ASSERT_EQ(ev_a.manifest.stages.size(), 2u);
+  ASSERT_EQ(ev_b.manifest.stages.size(), 2u);
+  EXPECT_EQ(ev_a.manifest.stages[0].status, "succeeded");
+  EXPECT_EQ(ev_a.manifest.stages[1].status, "succeeded");
+  EXPECT_EQ(ev_b.manifest.stages[0].status, "succeeded");
+  EXPECT_EQ(ev_b.manifest.stages[1].status, "succeeded");
+
+  CollectEvidence(*engine_a, ParseUuid(kAc22ProjectA), &ev_a);
+  CollectEvidence(*engine_b, ParseUuid(kAc22ProjectB), &ev_b);
+
+  // тФАтФА Input identity: the ONLY config divergence is the owning project.
+  ASSERT_EQ(ev_a.recon_hash, ev_b.recon_hash);  // bit-identical committed input
+  ASSERT_EQ(ev_a.src_art_hash, ev_b.src_art_hash);
+  ASSERT_EQ(ev_a.tgt_art_hash, ev_b.tgt_art_hash);
+  EXPECT_NE(ev_a.cfg.dump(), ev_b.cfg.dump());  // project id and the runtime
+  // feature-artifact UUIDs differ; normalizing those three runtime-only
+  // coordinates makes the configs byte-identical...
+  json a_cfg_as_b = ev_a.cfg;
+  a_cfg_as_b["project_id"] = kAc22ProjectB;
+  a_cfg_as_b["loop_closure"]["source_frame"]["feature_artifact_uuid"] =
+      "pinned-ac22";
+  a_cfg_as_b["loop_closure"]["target_frame"]["feature_artifact_uuid"] =
+      "pinned-ac22";
+  json b_cfg = ev_b.cfg;
+  b_cfg["loop_closure"]["source_frame"]["feature_artifact_uuid"] =
+      "pinned-ac22";
+  b_cfg["loop_closure"]["target_frame"]["feature_artifact_uuid"] =
+      "pinned-ac22";
+  EXPECT_EQ(a_cfg_as_b.dump(), b_cfg.dump());  // ...everything else agrees
+  EXPECT_EQ(ev_a.manifest.config_hash, Sha256Hex(ev_a.cfg.dump()));
+  EXPECT_EQ(ev_b.manifest.config_hash, Sha256Hex(ev_b.cfg.dump()));
+  EXPECT_EQ(Sha256Hex(a_cfg_as_b.dump()), Sha256Hex(b_cfg.dump()));
+  EXPECT_NE(ev_a.manifest.config_hash, ev_b.manifest.config_hash);
+  EXPECT_NE(ev_a.manifest.pipeline_hash, ev_b.manifest.pipeline_hash);
+  EXPECT_FALSE(ev_a.manifest.pipeline_hash.empty());
+  EXPECT_FALSE(ev_b.manifest.pipeline_hash.empty());
+
+  // тФАтФА Level A semantics: measurement -> graph -> optimization -> revisions.
+  ExpectClosureCoreEqual(ev_a, ev_b);
+  ExpectPoseGraphCoreEqual(ev_a, ev_b);
+  ExpectOptimizationCoreEqual(ev_a, ev_b);
+  ExpectCorrectionRevisionsEqual(ev_a, ev_b);
+
+  // тФАтФА Level B provenance + lineage: identical chain topology and roots.
+  ASSERT_EQ(ev_a.rows.size(), 4u);
+  ASSERT_EQ(ev_b.rows.size(), 4u);
+  {
+    std::map<std::string, std::string> sa, sb;
+    for (const auto& row : ev_a.rows)
+      sa[FormatUuid(row.reconstruction_id)] = row.status;
+    for (const auto& row : ev_b.rows)
+      sb[FormatUuid(row.reconstruction_id)] = row.status;
+    const json committed_a = FindDocByBackend(ev_a.rows, "colmap");
+    const json committed_b = FindDocByBackend(ev_b.rows, "colmap");
+    ASSERT_FALSE(committed_a.is_null());
+    ASSERT_FALSE(committed_b.is_null());
+    EXPECT_EQ(committed_a["reconstruction_id"].get<std::string>(),
+              std::string(kAc22ReconId));
+    EXPECT_EQ(committed_a, committed_b);  // committed revision byte-identical
+    EXPECT_EQ(sa[committed_a["reconstruction_id"].get<std::string>()],
+              "superseded");
+    EXPECT_EQ(sb[committed_b["reconstruction_id"].get<std::string>()],
+              "superseded");
+    EXPECT_EQ(sa[ev_a.applied["reconstruction_id"].get<std::string>()],
+              "superseded");
+    EXPECT_EQ(sb[ev_b.applied["reconstruction_id"].get<std::string>()],
+              "superseded");
+    EXPECT_EQ(sa[ev_a.v3["reconstruction_id"].get<std::string>()],
+              "superseded");
+    EXPECT_EQ(sb[ev_b.v3["reconstruction_id"].get<std::string>()],
+              "superseded");
+    EXPECT_EQ(sa[ev_a.v4["reconstruction_id"].get<std::string>()],
+              "succeeded");
+    EXPECT_EQ(sb[ev_b.v4["reconstruction_id"].get<std::string>()],
+              "succeeded");
+    int succeeded = 0;
+    for (const auto& entry : sb) succeeded += (entry.second == "succeeded");
+    EXPECT_EQ(succeeded, 1);
+  }
+
+  // Provenance: the chain's deterministic root тАФ the committed reconstruction
+  // payload, whose CAS content hash is bit-identical across the twins тАФ is
+  // present in every downstream lineage. The remaining lineage entries are hash
+  // references to runtime-identity artifacts (fresh revision ids, the
+  // optimization-result payload carrying result_id/graph_id) and therefore
+  // differ between the twins by contract; what must agree is the topology.
+  {
+    const json applied_a = ev_a.applied;
+    std::vector<std::string> applied_hashes_a;
+    for (const auto& h : applied_a["provenance"]["input_artifact_hashes"])
+      applied_hashes_a.push_back(h.get<std::string>());
+    const json applied_b = ev_b.applied;
+    std::vector<std::string> applied_hashes_b;
+    for (const auto& h : applied_b["provenance"]["input_artifact_hashes"])
+      applied_hashes_b.push_back(h.get<std::string>());
+    // applied (spatial_optimizer) lineage = { committed payload, freshly
+    // persisted optimization-result payload } (reconstruction_feedback.h ┬з8.1).
+    EXPECT_EQ(applied_hashes_a.size(), 2u);
+    EXPECT_EQ(applied_hashes_b.size(), 2u);
+    EXPECT_NE(std::find(applied_hashes_a.begin(), applied_hashes_a.end(),
+                        ev_a.recon_hash),
+              applied_hashes_a.end());
+    EXPECT_NE(std::find(applied_hashes_b.begin(), applied_hashes_b.end(),
+                        ev_b.recon_hash),
+              applied_hashes_b.end());
+    // The companion entry references exactly the optimization-result artifact
+    // this test independently resolved (same bytes -> same hash -> same doc).
+    for (const auto& h : applied_hashes_a) {
+      if (h == ev_a.recon_hash) continue;
+      const auto ref_a = store_a.Get(h);
+      ASSERT_TRUE(ref_a.has_value());
+      EXPECT_EQ(json::parse(std::string(ref_a->begin(), ref_a->end())),
+                ev_a.opt_payload);
+    }
+    for (const auto& h : applied_hashes_b) {
+      if (h == ev_b.recon_hash) continue;
+      const auto ref_b = store_b.Get(h);
+      ASSERT_TRUE(ref_b.has_value());
+      EXPECT_EQ(json::parse(std::string(ref_b->begin(), ref_b->end())),
+                ev_b.opt_payload);
+    }
+
+    const json v3_a = ev_a.v3;
+    const json v3_b = ev_b.v3;
+    std::vector<std::string> v3_hashes_a;
+    for (const auto& h : v3_a["provenance"]["input_artifact_hashes"])
+      v3_hashes_a.push_back(h.get<std::string>());
+    std::vector<std::string> v3_hashes_b;
+    for (const auto& h : v3_b["provenance"]["input_artifact_hashes"])
+      v3_hashes_b.push_back(h.get<std::string>());
+    // v3 (spatial_retriangulator) lineage = applied lineage + the applied
+    // reconstruction id (triangulation.h ┬з4.11): same topology in both twins,
+    // the only cross-twin difference being the two runtime revision ids.
+    EXPECT_EQ(v3_hashes_a.size(), 3u);
+    EXPECT_EQ(v3_hashes_b.size(), 3u);
+    for (const std::string& h : applied_hashes_a) {
+      EXPECT_NE(std::find(v3_hashes_a.begin(), v3_hashes_a.end(), h),
+                v3_hashes_a.end());
+    }
+    for (const std::string& h : applied_hashes_b) {
+      EXPECT_NE(std::find(v3_hashes_b.begin(), v3_hashes_b.end(), h),
+                v3_hashes_b.end());
+    }
+    EXPECT_NE(std::find(v3_hashes_a.begin(), v3_hashes_a.end(),
+                        applied_a["reconstruction_id"].get<std::string>()),
+              v3_hashes_a.end());
+    EXPECT_NE(std::find(v3_hashes_b.begin(), v3_hashes_b.end(),
+                        applied_b["reconstruction_id"].get<std::string>()),
+              v3_hashes_b.end());
+  }
+
+  // тФАтФА Latest-succeeded view agrees (only the fresh v4 id differs).
+  {
+    const auto scene_a =
+        engine_a->project().db().FindSceneByProject(ParseUuid(kAc22ProjectA));
+    const auto scene_b =
+        engine_b->project().db().FindSceneByProject(ParseUuid(kAc22ProjectB));
+    ASSERT_TRUE(scene_a.has_value());
+    ASSERT_TRUE(scene_b.has_value());
+    const auto latest_a = engine_a->project().db()
+                              .QueryLatestReconstructionByScene(scene_a->scene_id);
+    const auto latest_b = engine_b->project().db()
+                              .QueryLatestReconstructionByScene(scene_b->scene_id);
+    ASSERT_TRUE(latest_a.has_value());
+    ASSERT_TRUE(latest_b.has_value());
+    EXPECT_EQ(latest_a->reconstruction_id,
+              ParseUuid(ev_a.v4["reconstruction_id"].get<std::string>()));
+    EXPECT_EQ(latest_b->reconstruction_id,
+              ParseUuid(ev_b.v4["reconstruction_id"].get<std::string>()));
+    EXPECT_NE(latest_a->reconstruction_id, latest_b->reconstruction_id);
+  }
+
+  // тФАтФА N5 replay with the REAL seams, inside run A's project: an identical
+  // invocation (same payload + same config) re-executes the kNever stage and
+  // FAILS CLOSED at the duplicate committed identity тАФ never a cache hit, never
+  // a second/divergent reconstruction. The revision lineage stays byte-identical.
+  {
+    const auto replay = engine_a->RunPipeline(kSparseCorrectionPipelineId,
+                                              {ev_a.recon_hash},
+                                              ev_a.cfg.dump());
+    EXPECT_EQ(replay.status, "failed");
+    ASSERT_EQ(replay.stages.size(), 2u);
+    EXPECT_EQ(replay.stages[0].status, "succeeded");
+    EXPECT_EQ(replay.stages[1].status, "failed");
+    EXPECT_EQ(replay.stages[0].output_refs, ev_a.manifest.stages[0].output_refs);
+    ASSERT_EQ(replay.stages[0].output_refs.size(), 1u);
+    EXPECT_EQ(replay.stages[0].output_refs.front(), ev_a.recon_hash);
+    EXPECT_FALSE(replay.stages[1].cache_hit);  // kNever: recomputed, not cached
+    EXPECT_FALSE(replay.pipeline_hash.empty());
+    EXPECT_EQ(replay.pipeline_hash, ev_a.manifest.pipeline_hash);
+
+    const auto scene_a =
+        engine_a->project().db().FindSceneByProject(ParseUuid(kAc22ProjectA));
+    ASSERT_TRUE(scene_a.has_value());
+    const auto after = engine_a->project().db().FindReconstructionsByScene(
+        scene_a->scene_id);
+    ASSERT_EQ(after.size(), 4u);
+    for (std::size_t i = 0; i < after.size(); ++i) {
+      EXPECT_EQ(after[i].reconstruction_id, ev_a.rows[i].reconstruction_id);
+      EXPECT_EQ(after[i].status, ev_a.rows[i].status);
+      EXPECT_EQ(after[i].document_json, ev_a.rows[i].document_json);
+    }
+    const auto latest = engine_a->project().db()
+                            .QueryLatestReconstructionByScene(scene_a->scene_id);
+    ASSERT_TRUE(latest.has_value());
+    EXPECT_EQ(latest->reconstruction_id,
+              ParseUuid(ev_a.v4["reconstruction_id"].get<std::string>()));
+  }
+}
